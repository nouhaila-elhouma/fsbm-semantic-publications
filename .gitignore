# Secrets
.env

# Environnements Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# Logs (le dossier est conservé grâce à .gitkeep)
outputs/logs/*.log
outputs/logs/*.txt

# PDF source des membres (document institutionnel : à ne pas redistribuer sans accord)
data/input/*.pdf

# Pages Google Scholar enregistrées à la main (contenu tiers, non redistribué) et liste de travail
data/input/scholar_html/*
!data/input/scholar_html/.gitkeep
outputs/reports/profils_a_enregistrer.html

# Cache de scraping / d'enrichissement (reconstructible, volumineux)
data/raw/cache/*
!data/raw/cache/.gitkeep

# Archive préparée pour Google Colab (temporaire, reconstructible avec scripts/make_colab_bundle.py)
outputs/colab/

# NB : les embeddings zembed-1 (n x 2560 float32 ~ 20-30 Mo), l'index FAISS et les cartes interactives
# sont des LIVRABLES du sujet : ils sont versionnés (data/vector_store/, outputs/figures/).

.DS_Store
Thumbs.db
