# Copier ce fichier en ".env" puis renseigner les valeurs. NE JAMAIS committer ".env".

# OPTIONNEL — clé API ZeroEntropy (API hébergée de zembed-1). Inutile en mode par défaut : zembed-1 s'exécute en local
# avec les poids ouverts officiels (embedding.transport: local). ZeroEntropy n'accepte plus de nouvelles inscriptions.
ZEROENTROPY_API_KEY=

# Email de contact transmis dans le User-Agent des API académiques publiques
# (Crossref "polite pool", OpenAlex). Recommandé : votre email universitaire.
CONTACT_EMAIL=

# Optionnel : clé Semantic Scholar (augmente la limite de débit ; le pipeline fonctionne sans)
SEMANTIC_SCHOLAR_API_KEY=
